# AICTE FlowGuard — environment configuration (copy to .env)

# HTTP port for the combined API + UI server
PORT=3000

# --- Database -------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded PostgreSQL (PGlite) stored in PGLITE_DATA_DIR.
# For Supabase, set the Postgres connection string (Project Settings → Database). AWAITING CONFIGURATION / NOT TESTED.
DATABASE_URL=
PGLITE_DATA_DIR=./data/pgdata

# --- Document storage -----------------------------------------------------
# Private local directory (never served statically). Supabase Storage adapter: awaiting configuration.
STORAGE_DIR=./data/storage

# Seed demo institutions and TEST accounts on start (development only). Set to false in any real deployment.
SEED_DEMO=true

# NODE_ENV=production enables Secure cookies and serves the built UI from ./dist
NODE_ENV=development

# --- Background jobs ------------------------------------------------------
# Deadline / EVC follow-up sweep interval (ms) and supervisor escalation threshold (days). System policy, not APH.
# SWEEP_INTERVAL_MS=300000
# ESCALATE_AFTER_OVERDUE_DAYS=2
# DISABLE_SCHEDULER=false
# Other follow-up periods (EVC acknowledgement / report, expiry alerts) are stored in the database and changed
# under Operational settings (proposed by an administrator, authorised by a supervisor).

# --- Email Notifications (Resend) ----------------------------------------
# Resend API Key (starts with re_). Get yours at https://resend.com
RESEND_API_KEY=
RESEND_FROM=AICTE FlowGuard <onboarding@resend.dev>

# --- WhatsApp Notifications (Twilio) --------------------------------------
# Twilio Account SID & Auth Token from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Standard Twilio WhatsApp Sandbox number is whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Demo Alert Overrides (Optional) --------------------------------------
# Force all test alerts to send to your personal email and WhatsApp for live judging/demos:
# DEMO_ALERT_EMAIL=you@example.com
# DEMO_ALERT_PHONE=+919876543210

